//| mvnDeps: ["com.goyeau::mill-scalafix_mill1:0.6.0", "com.lihaoyi::mill-contrib-jmh:1.1.8"]
package build

import mill._
import mill.scalalib._
import mill.scalalib.publish._
import mill.scalalib.scalafmt.ScalafmtModule
import mill.javalib.SonatypeCentralPublishModule
import mill.util.Jvm
import com.goyeau.mill.scalafix.ScalafixModule
import mill.contrib.jmh.JmhModule

val scala3Version = "3.8.4"

/**
 * spire-opencl — spire/algebra typeclasses at a symbolic value type, compiled to OpenCL.
 *
 * Instantiate polymorphic numeric code at `Expr` instead of `Double` and you get the expression tree
 * it would have computed; `CodeGen` turns that tree into an OpenCL kernel and `ClKernel` runs it.
 * The library knows nothing about what the numbers mean.
 */
object spireOpencl extends ScalaModule with ScalafmtModule with ScalafixModule with SonatypeCentralPublishModule {
  def scalaVersion = scala3Version
  def artifactName = "spire-opencl"

  // Single-module repo: sources live at the top level, not under a directory named after the module.
  def moduleDir = super.moduleDir / os.up
  def sources   = Task.Sources(moduleDir / "src" / "main" / "scala")

  /**
   * The git tag is the version, so a release is `git tag v0.1.0 && git push --tags` and nothing else.
   * Anywhere but a tag build this stays a snapshot, which is also what `publishLocal` gets.
   *
   * Task.Input, not Task: a cached task would keep the first tag it ever saw.
   */
  def publishVersion = Task.Input {
    Task.env.get("GITHUB_REF_NAME").filter(_.matches("v\\d.*")).map(_.drop(1)).getOrElse("0.1.0-SNAPSHOT")
  }

  def pomSettings = PomSettings(
    description    = "Symbolic interpretation of spire/algebra typeclasses, compiled to OpenCL kernels",
    organization   = "io.github.mercurievv",
    url            = "https://github.com/MercurieVV/spire-opencl",
    licenses       = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("MercurieVV", "spire-opencl"),
    developers     = Seq(Developer("MercurieVV", "Victor Mercurievv", "https://github.com/MercurieVV")),
  )

  def scalacOptions = Seq(
    "-language:strictEquality",
    "-Xkind-projector:underscores",
    "-Wunused:imports",
  )

  // Same warts as skreeep2, as warnings rather than errors.
  private val warts = Seq(
    "Var", "MutableDataStructures", "NonUnitStatements", "Throw",
    "Return", "AsInstanceOf", "IsInstanceOf", "Null",
  )

  def scalacPluginMvnDeps = Seq(mvn"org.wartremover:::wartremover:3.6.1")
  def mandatoryScalacOptions =
    super.mandatoryScalacOptions() ++ warts.map(w => s"-P:wartremover:only-warn-traverser:org.wartremover.warts.$w")

  def mvnDeps = Seq(
    mvn"org.typelevel::algebra:2.13.0",
    mvn"org.typelevel::spire:0.18.0",
    mvn"org.typelevel::cats-core:2.13.0",
    mvn"org.typelevel::cats-effect:3.6.3",
    mvn"org.jocl:jocl:2.0.5",
  )

  object test extends ScalaTests with TestModule.Weaver {
    def moduleDir = spireOpencl.moduleDir
    def sources   = Task.Sources(moduleDir / "src" / "test" / "scala")
    def mvnDeps   = Seq(mvn"com.disneystreaming::weaver-cats:0.8.4")
  }
}

/**
 * JMH benchmarks: this library against the same numeric program run on the JVM.
 *
 * Its own directory (`bench/src`), not `moduleDir / os.up`. `spireOpencl` already claims the repo
 * root as its base directory, and IntelliJ keys a module on that directory — two modules sharing one
 * would import as a single collapsed module with one module's classpath applied to both.
 *
 * No wartremover and no `-language:strictEquality`: a JMH `@State` class is a mutable bean by
 * construction and the generated harness compares boxed values.
 */
object bench extends ScalaModule with JmhModule with ScalafmtModule {
  def scalaVersion = scala3Version
  def jmhCoreVersion      = "1.37"
  def jmhGeneratorVersion = "1.37"
  def moduleDeps   = Seq(spireOpencl)

  // JmhModule puts jmh on the generator and run classpaths, not on the one that compiles the annotated sources.
  // upickle/os-lib are for `History`, which reads the recorded reports back.
  def mvnDeps = Seq(
    mvn"org.scalanlp::breeze:2.1.0",
    mvn"org.openjdk.jmh:jmh-core:1.37",
    mvn"com.lihaoyi::upickle:4.4.3",
    mvn"com.lihaoyi::os-lib:0.11.8",
  )

  /**
   * Where recorded runs live. Resolved from the workspace root rather than from `moduleDir`, because it
   * is a repo path this module happens to own, not part of the module's own layout.
   */
  def resultsDir: os.Path = mill.api.BuildCtx.workspaceRoot / "bench" / "results"

  private def recorded(): Seq[os.Path] =
    if !os.exists(resultsDir) then Nil
    else os.list(resultsDir).filter(p => p.ext == "json").sortBy(os.mtime)

  /**
   * Run the benchmarks and keep the report, then compare it against the previous one.
   *
   * `runJmh` executes with `cwd` inside mill's `out`, so `-rff` has to be given an absolute path or the
   * report lands somewhere no one will look for it again. Everything else the caller passes is appended,
   * so `./mill bench.record -f 1 -wi 2 -i 3 GeneratorBench` still records.
   *
   * Exclusive because it is a benchmark: anything else mill runs in parallel is measurement noise.
   */
  def record(args: String*) = Task.Command(exclusive = true) {
    val previous = recorded().lastOption
    os.makeDir.all(resultsDir)
    val stamp = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd-HHmmss"))
    val report = resultsDir / s"$stamp.json"

    val (_, resources) = generateBenchmarkSources()
    Jvm.callProcess(
      mainClass = "org.openjdk.jmh.Main",
      classPath = (runClasspath() ++ generatorDeps()).map(_.path) ++ Seq(jmhGeneratedSources().path, resources.path),
      mainArgs = Seq("-rf", "json", "-rff", report.toString) ++ args,
      cwd = Task.ctx().dest,
      javaHome = javaHome().map(_.path),
      stdin = os.Inherit,
      stdout = os.Inherit,
    )

    Task.log.info(s"recorded $report")
    previous match {
      case None       => Task.log.info("no earlier run to compare against; this one is the baseline")
      case Some(base) => compareReports(runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator), base, report)
    }
    PathRef(report)
  }

  /**
   * Compare two recorded reports without running anything. With no arguments, the two most recent;
   * with two paths, those. A third argument overrides the regression threshold in percent.
   */
  def compare(args: String*) = Task.Command(exclusive = true) {
    val files = recorded()
    val (base, current, rest) = args.toList match {
      case a :: b :: tail => (os.Path(a, mill.api.BuildCtx.workspaceRoot), os.Path(b, mill.api.BuildCtx.workspaceRoot), tail)
      case tail           =>
        if files.length < 2 then throw new IllegalStateException(s"need two recorded runs in $resultsDir, found ${files.length}")
        else (files(files.length - 2), files.last, tail)
    }
    compareReports(runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator), base, current, rest)
  }

  /**
   * Rates rather than durations for a recorded run: elements/s, GB/s against the memory the arithmetic
   * runs out of, operations/s, and arithmetic intensity. Defaults to the most recent report.
   */
  def report(args: String*) = Task.Command(exclusive = true) {
    val target = args.headOption
      .map(a => os.Path(a, mill.api.BuildCtx.workspaceRoot))
      .orElse(recorded().lastOption)
      .getOrElse(throw new IllegalStateException(s"no recorded runs in $resultsDir"))
    os.proc(
      Jvm.jdkTool("java"),
      "-cp",
      runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator),
      "io.github.mercurievv.spireopencl.bench.Report",
      target.toString,
    ).call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit)
    ()
  }

  /**
   * ULP error of every transcendental against the same operation in Double, plus error along a dependent
   * chain and whether the device flushes subnormals. Exits non-zero if anything exceeds what the OpenCL
   * specification permits.
   */
  def precision() = Task.Command(exclusive = true) {
    val result = os.proc(
      Jvm.jdkTool("java"),
      "-cp",
      runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator),
      "io.github.mercurievv.spireopencl.bench.Precision",
    ).call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit, check = false)
    if (result.exitCode != 0) Task.fail("an operation exceeds the accuracy the OpenCL specification permits")
  }

  /** The recorded runs, oldest first. */
  def history() = Task.Command(exclusive = true) {
    val files = recorded()
    if files.isEmpty then Task.log.info(s"no recorded runs in $resultsDir")
    else files.foreach(p => Task.log.info(s"${java.time.Instant.ofEpochMilli(os.mtime(p))}  ${p.last}"))
    files.map(PathRef(_))
  }

  /**
   * `classPath` is passed in rather than read here: `runClasspath()` resolves a task, which is only legal
   * inside a task body, and this is a plain method shared by three of them.
   */
  private def compareReports(classPath: String, base: os.Path, current: os.Path, extra: List[String] = Nil)(
      implicit ctx: mill.api.TaskCtx
  ): Unit = {
    // A regression exits non-zero, which is the point of the check, so the process result is inspected
    // rather than left to abort the build with a stack trace that says nothing.
    val result = os.proc(
      Jvm.jdkTool("java"),
      "-cp",
      classPath,
      "io.github.mercurievv.spireopencl.bench.History",
      base.toString,
      current.toString,
      extra,
    ).call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit, check = false)
    // `Task.fail`, not an exception: a regression is a result, and a stack trace through the build file
    // says nothing the report above has not already said.
    if (result.exitCode != 0) Task.fail(s"benchmark regression against ${base.last}")
  }

  object test extends ScalaTests with TestModule.Weaver {
    def mvnDeps = Seq(mvn"com.disneystreaming::weaver-cats:0.8.4")
  }
}

/**
 * Checks `docs/README.md` against the real API: every `scala mdoc` fence is compiled (and, unless
 * marked `compile-only`, run) by `mdoc`. No third-party mill plugin — the existing ones target the
 * pre-1.0 `build.sc`/`$ivy` config style and don't load under this build's module system.
 *
 * `moduleDeps = Seq(spireOpencl)` puts the real compiled module on the fence-compile classpath. The
 * forced `scala3-compiler` mvnDep matters: mdoc's own published release pins an older Scala 3 LTS
 * compiler, and without the override coursier leaves both that and this project's scala3-library on
 * the classpath together, which dotc rejects ("package scala contains object and package with same
 * name: caps"). Forcing the version also means mdoc checks fences with the *same* compiler this
 * project actually builds with, so syntax new to this project's scalaVersion (e.g. `V: {Field, Trig}`
 * multi-bounds) is understood rather than rejected as too new.
 */
object docs extends ScalaModule {
  def scalaVersion = scala3Version
  def moduleDeps   = Seq(spireOpencl)
  def sources      = Task.Sources(moduleDir / os.up / "mdoc-docs" / "src" / "main" / "scala")
  def mvnDeps = Seq(
    mvn"org.scalameta::mdoc:2.9.0",
    mvn"org.typelevel::laika-io:1.3.2",
    mvn"com.lihaoyi::upickle:4.4.3",
    mvn"org.scala-lang::scala3-compiler:$scala3Version",
  )

  // Directory mode: every `.md` under here is checked (`README.md` plus any further pages, e.g. `var-operations.md`).
  def mdocSource = Task.Source(moduleDir)

  /** The newest `vX.Y.Z` release tag, for `@VERSION@` in setup instructions — not `spireOpencl.publishVersion`, which is
    * a `-SNAPSHOT` on every build except the tag build itself. Docs rebuild on ordinary master pushes far more often
    * than on a release, and a reader's `libraryDependencies +=` line should show what they can actually depend on right
    * now regardless of which push triggered this build — which is why this reads the tag list instead of the ref.
    *
    * `git tag --sort=-v:refname` is git's own version-aware sort, descending, so the first line is the newest release;
    * no manual semver parsing to keep in sync with `publishVersion`'s. Task.Input, not Task: a cached task would keep
    * the first tag it ever saw.
    */
  def latestReleaseVersion = Task.Input {
    os.proc("git", "tag", "--list", "v*", "--sort=-v:refname")
      .call(cwd = mill.api.BuildCtx.workspaceRoot)
      .out
      .lines()
      .headOption
      .map(_.drop(1))
      .getOrElse("0.1.0-SNAPSHOT")
  }

  private def preparedMarkdown = Task {
    val dest = Task.dest / "docs"
    os.makeDir.all(dest)
    os.copy.over(mdocSource().path, dest, createFolders = true)
    Jvm.callProcess(
      mainClass = "docs.BenchmarkResults",
      classPath = runClasspath().map(_.path).toSeq,
      mainArgs = Seq(
        (moduleDir / os.up / "bench" / "results" / "2026-08-15-apple-m3-max.json").toString,
        (moduleDir / os.up / "bench" / "results" / "2026-08-24-170344.json").toString,
        (dest / "benchmarking.md").toString,
      ),
    )
    PathRef(dest)
  }

  private def checkedMarkdown = Task {
    val prepared = preparedMarkdown()
    Jvm.callProcess(
      mainClass = "mdoc.Main",
      classPath = runClasspath().map(_.path).toSeq,
      mainArgs = Seq(
        "--in",
        prepared.path.toString,
        "--out",
        Task.dest.toString,
        "--classpath",
        runClasspath().map(_.path).mkString(java.io.File.pathSeparator),
        "--site.VERSION",
        latestReleaseVersion(),
      ),
    )
    PathRef(Task.dest)
  }

  def mdoc() = Task.Command {
    checkedMarkdown()
  }

  def site() = Task.Command {
    val checked = checkedMarkdown()
    Jvm.callProcess(
      mainClass = "docs.DocsMain",
      classPath = runClasspath().map(_.path).toSeq,
      mainArgs = Seq(
        checked.path.toString,
        Task.dest.toString,
      ),
    )
    PathRef(Task.dest)
  }
}
